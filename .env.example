# ============================================================
# MyFacilitator – Environment Variables Reference
# Backend: Railway (PostgreSQL + Flask/FastAPI) — NOT Supabase
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Frontend (Vite) ──────────────────────────────────────────
# The Railway backend URL. In local development, set to http://localhost:3333
VITE_API_URL=https://friendly-ai-sessions-production.up.railway.app

# JWT anon key (signed with JWT_SECRET on the Railway backend)
# In production this is validated by the Railway proxy.
VITE_API_ANON_KEY=your_jwt_anon_key_here

# Stripe publishable key (safe to expose in frontend – this is NOT a secret key)
# Get from: https://dashboard.stripe.com/apikeys
# Use pk_test_... for test mode, pk_live_... for live mode.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Enable verbose debug logging in the browser console (set to 'true' for local dev)
# VITE_DEBUG=true

# ── Acquisition Tracking (Frontend – public IDs only) ─────────────────────────
# GA4 Measurement ID. Example: G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=

# Google Ads global tag ID created for AIfacilitator.
VITE_GOOGLE_ADS_ID=AW-18162348578

# Google Ads conversion labels. These are the label part after AW-18162348578/...
# Get them from Google Ads > Goals > Conversions > conversion action > Tag setup.
VITE_GOOGLE_ADS_SIGNUP_CONVERSION_LABEL=
VITE_GOOGLE_ADS_CONTACT_CONVERSION_LABEL=
VITE_GOOGLE_ADS_BEGIN_CHECKOUT_CONVERSION_LABEL=
VITE_GOOGLE_ADS_PURCHASE_CONVERSION_LABEL=

# Microsoft UET tag already installed globally in index.html.
VITE_MICROSOFT_UET_ID=343249109

# Microsoft Clarity project ID. Leave empty to disable heatmaps/session replay.
VITE_CLARITY_PROJECT_ID=

# ── Railway Proxy (Backend) ──────────────────────────────────
# PostgreSQL connection – Railway auto-injects these from the linked Postgres service.
# Only set manually for local development.
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_facilitator
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
# Alternatively, set a full DATABASE_URL (takes priority over the individual vars above):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret used to sign and verify auth tokens.
# Must match the secret used to generate VITE_API_ANON_KEY.
JWT_SECRET=your_jwt_secret_here

# OpenAI API key for AI facilitation responses.
OPENAI_API_KEY=sk-your_openai_api_key_here

# ── Stripe (Backend – Railway Proxy) ────────────────────────
# STRIPE_ENV controls which key pair is active: 'test' or 'live'
# Defaults to 'test' if not set.
STRIPE_ENV=test

# Test mode keys (used when STRIPE_ENV=test)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY_TEST=sk_test_your_test_secret_key_here
STRIPE_WEBHOOK_SECRET_TEST=whsec_your_test_webhook_secret_here

# Live mode keys (used when STRIPE_ENV=live)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY_LIVE=sk_live_your_live_secret_key_here
STRIPE_WEBHOOK_SECRET_LIVE=whsec_your_live_webhook_secret_here

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Defaults to localhost + the Vercel deployment URL if not set.
ALLOWED_ORIGINS=https://friendly-ai-sessions.vercel.app,http://localhost:5173

# ── Storage ──────────────────────────────────────────────────
# Directory for uploaded files (avatars, reports, etc.)
STORAGE_DIR=/app/storage

# ── Cloudflare Turnstile (anti-spam for contact form) ────────────────────────
# Frontend: the public site key (safe to expose in browser)
# Get from: https://dash.cloudflare.com/ -> Turnstile
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADIjelTVXywXD9b-
# Backend (Railway): the secret key used to verify tokens server-side
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ── Crisp (contact form -> Crisp conversations) ──────────────────────────────
# Website Token credentials generated in Crisp -> Settings -> Advanced Configuration
# Get from: https://app.crisp.chat/settings/website/{WEBSITE_ID}/advanced/
CRISP_WEBSITE_ID=2fa7d9e8-136f-4814-a20c-3cd59756b396
CRISP_API_IDENTIFIER=your_crisp_api_identifier_here
CRISP_API_KEY=your_crisp_api_key_here
