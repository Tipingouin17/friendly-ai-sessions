# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe publishable key (safe to expose in frontend - this is NOT a secret key)
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Optional: For backend/server-side operations only
# WARNING: NEVER commit the service role key or expose it in frontend code!
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
